84,-43.67,-52.74,-26.57,-17.76,-3.68,-33.56,-15.17,-8.29,-15.95,0.54,-1.09,1.78,26.45,-5.76,-32.96,24.64,-14.93,-6.03,-5.58,26.15,17.67,5.43,21.86,41.65,44.69,37.7,48.52,52.99,31.39,37.21,37.61,29.7,32.66,23.79,48.28,52.35,51.0,63.81,38.27,53.23,66.76],"phase":["Neutral","Neutral","El Niño","El Niño","La Niña","Neutral","Neutral","El Niño","Neutral","El Niño","El Niño","La Niña","Neutral","El Niño","La Niña","La Niña","Neutral","Neutral","El Niño","Neutral","El Niño","Neutral","Neutral","La Niña","Neutral","Neutral","La Niña","Neutral","Neutral","Neutral","Neutral","El Niño","La Niña","La Niña","Neutral","Neutral","La Niña","La Niña","La Niña","El Niño","La Niña","La Niña","El Niño"]}}},"nat":"Agro-pastoral south","composites":[],"regressions":[],"tracker":[],"tracker_year":null,"elnino_stamp":null,"plans":[{"level":"national","name":"DCAN and the annual National Response Plan (Plan national de réponse, PNR)","who":"Commissariat à la sécurité alimentaire (CSA); Ministry of Economic Affairs","what":"National system for preventing and responding to food and nutrition crises (created 2021): annual assessment (field surveys, rainfall, harvests, prices), targeting through the Cadre Harmonisé, lean-season response, special State fund. Round table on financing the 2026 PNR held in May 2026, after a 2025 season with poorly distributed rain.","trigger":"Cadre Harmonisé results (November and March cycles)","elnino":"Not El Niño-specific: the 2026–27 response will be set by the November 2026 Cadre Harmonisé cycle.","url":"https://www.lecalame.info/?q=node%2F18542","src":"Le Calame, 22 May 2026"},{"level":"national","name":"Adaptive social protection: Social Registry, Tekavoul and Elmaouna","who":"Taazour (national solidarity agency), with the World Bank","what":"Tekavoul: quarterly cash transfers to poor households in the Social Registry (over 100,000 households in 2024; 3,600 MRU per quarter). Elmaouna: seasonal cash response to droughts and floods since 2017 (over 131,000 households, about 814,000 people, 2017–2023), extended to M'bera refugees.","trigger":"Drought or flood shock (linked to the food-security early-warning system)","elnino":"The main instrument to scale up quickly if the 2026 season fails; scale versus needs is the question.","url":"https://www.banquemondiale.org/fr/news/feature/2024/09/05/afw-transforming-lives-in-mauritania-through-adaptive-social-protection","src":"World Bank, 5 September 2024"},{"level":"national","name":"Drought index insurance (African Risk Capacity) and ADRiFi","who":"CSA, African Risk Capacity (African Union), African Development Bank","what":"Parametric drought insurance: payout when a rainfall-based index shows losses. First ARC payout in January 2015: USD 25 million shared by Mauritania, Niger and Senegal. ADRiFi (AfDB, USD 2.1 million grant) paid half of the 2020–2021 premiums and set up a drought-response plan.","trigger":"Rainfall-based drought index (Africa RiskView)","elnino":"Whether a policy covers the 2026 season is not confirmed in the sources consulted.","url":"https://www.mfw4a.org/news/drought-arc-pay-out-25-million-mauritania-niger-and-senegal","src":"MFW4A, 27 January 2015; AfDB (ReliefWeb)"},{"level":"national","name":"Seasonal forecast of the National Meteorological Office (ONM)","who":"ONM","what":"April 2026 forecast: rainfall broadly normal with deficit tendencies; July–September normal to deficit in the eastern agro-pastoral zone, deficit to normal in the west.","trigger":"Ocean temperatures (Pacific, Atlantic, Indian Ocean, Mediterranean) and climate models","elnino":"Consistent with the AGRHYMET El Niño note: the western Sahel carries the highest risk.","url":"https://lecalame.info/?q=node%2F18346","src":"Le Calame, 5 April 2026"},{"level":"regional","name":"Cadre Harmonisé, PREGEC and RPCA (CILSS)","who":"CILSS / AGRHYMET, national Cadre Harmonisé cells","what":"Consensual classification of food insecurity in five phases, twice a year, which sets the national response plans. Mauritania, November 2025 cycle: 0.3 million people in phase 3+ (October–December 2025, 6%), 0.5 million projected for June–August 2026 (9.4%); localised forage deficits.","trigger":"Phase 3 (crisis) or worse","elnino":"The November 2026 cycle is the first to capture the 2026 El Niño season.","url":"https://agrhymet.cilss.int/wp-content/uploads/2026/08/RRSAN_DEFsigned.pdf","src":"AGRHYMET, Rapport régional 2026 sur la sécurité alimentaire et nutritionnelle"},{"level":"regional","name":"AGRHYMET El Niño technical note and seasonal forecasts (PRESASS)","who":"AGRHYMET Regional Climate Centre","what":"May 2026 note: a strong El Niño does not automatically mean a poor Sahel season; the western Sahel (Senegal, Mauritania, western Mali) has the highest risk of deficits, long dry spells and agricultural drought. Recommends monitoring the Atlantic, updating forecasts, and using them in agriculture, livestock, water and disaster-risk management.","trigger":"Seasonal forecast","elnino":"El Niño-specific guidance for the region.","url":"https://agrhymet.cilss.int/wp-content/uploads/2026/06/Technical-Note_AGRHYMET_ElNino_2026_English.pdf","src":"AGRHYMET, 31 May 2026"},{"level":"regional","name":"Sahel Adaptive Social Protection Program (SASPP)","who":"World Bank multi-donor trust fund; national safety-net agencies (Taazour in Mauritania)","what":"Supports adaptive social protection in Burkina Faso, Chad, Mali, Mauritania, Niger and Senegal (over USD 277 million since 2014): safety nets, economic inclusion, temporary support after shocks, social registries and digital payments. Third phase (2025–2030) launched in May 2026, with a focus on women, youth and jobs.","trigger":"Shocks identified by national systems","elnino":"Channel for early cash before the 2027 lean season.","url":"https://www.worldbank.org/en/news/press-release/2026/05/12/sahel-adaptive-social-protection-program-launches-next-phase-accelerate-job-creation-and-boost-resilience-in-the-sahel","src":"World Bank, 12 May 2026"},{"level":"international","name":"FAO–WFP El Niño Joint Anticipatory Action Appeal (June 2026–March 2027)","who":"FAO, WFP","what":"USD 202 million for 8.8 million people in 22 countries (cash, drought-tolerant seeds, livestock protection, water storage, early warning). Mauritania and the Sahel are not among the 22 countries.","trigger":"El Niño forecasts and country-specific triggers","elnino":"A gap for Mauritania: no international anticipatory envelope identified.","url":"https://www.fao.org/newsroom/detail/bracing-for-el-ni%C3%B1o--fao-and-wfp-launch-joint-appeal-to-protect-8.8-million-people-from-extreme-weather-events/en","src":"FAO, 18 June 2026"},{"level":"international","name":"Red Cross Red Crescent early action and UN CERF","who":"IFRC, national societies, Red Cross Red Crescent Climate Centre; UN OCHA (CERF)","what":"14 early action protocols ready in Africa; CERF pre-positioned up to USD 100 million for high-risk countries (September 2026). Recommended for drought-affected Sahel: water storage, drought-tolerant seeds, pasture conservation, early destocking, livestock health, managing tensions on transhumance routes.","trigger":"Forecast-based triggers in each protocol","elnino":"No Mauritania-specific protocol identified in the sources consulted.","url":"https://www.climatecentre.org/17861/el-nino-2026-27-no-excuse-for-inaction/","src":"Red Cross Red Crescent Climate Centre, 28 September 2026"}],"as_of":"4 November 2026","sources":["NOAA CPC, Relative Oceanic Niño Index (RONI); ENSO diagnostic discussion, 8 October 2026.","AGRHYMET RCC-WAS (2026). Technical Note — El Niño 2026, 31 May 2026.","El Niño notebook (El_Nino_impacts_MRT.ipynb): FAO ASIS / CHIRPS rainfall, ERA5-Land temperature, FAO ASIS / MODIS NDVI.","DCAN and the annual National Response Plan (Plan national de réponse, PNR) — Le Calame, 22 May 2026 : https://www.lecalame.info/?q=node%2F18542","Adaptive social protection: Social Registry, Tekavoul and Elmaouna — World Bank, 5 September 2024 : https://www.banquemondiale.org/fr/news/feature/2024/09/05/afw-transforming-lives-in-mauritania-through-adaptive-social-protection","Drought index insurance (African Risk Capacity) and ADRiFi — MFW4A, 27 January 2015; AfDB (ReliefWeb) : https://www.mfw4a.org/news/drought-arc-pay-out-25-million-mauritania-niger-and-senegal","Seasonal forecast of the National Meteorological Office (ONM) — Le Calame, 5 April 2026 : https://lecalame.info/?q=node%2F18346","Cadre Harmonisé, PREGEC and RPCA (CILSS) — AGRHYMET, Rapport régional 2026 sur la sécurité alimentaire et nutritionnelle : https://agrhymet.cilss.int/wp-content/uploads/2026/08/RRSAN_DEFsigned.pdf","AGRHYMET El Niño technical note and seasonal forecasts (PRESASS) — AGRHYMET, 31 May 2026 : https://agrhymet.cilss.int/wp-content/uploads/2026/06/Technical-Note_AGRHYMET_ElNino_2026_English.pdf","Sahel Adaptive Social Protection Program (SASPP) — World Bank, 12 May 2026 : https://www.worldbank.org/en/news/press-release/2026/05/12/sahel-adaptive-social-protection-program-launches-next-phase-accelerate-job-creation-and-boost-resilience-in-the-sahel","FAO–WFP El Niño Joint Anticipatory Action Appeal (June 2026–March 2027) — FAO, 18 June 2026 : https://www.fao.org/newsroom/detail/bracing-for-el-ni%C3%B1o--fao-and-wfp-launch-joint-appeal-to-protect-8.8-million-people-from-extreme-weather-events/en","Red Cross Red Crescent early action and UN CERF — Red Cross Red Crescent Climate Centre, 28 September 2026 : https://www.climatecentre.org/17861/el-nino-2026-27-no-excuse-for-inaction/"]}