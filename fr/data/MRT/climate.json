-53.32,-45.84,-43.67,-52.74,-26.57,-17.76,-3.68,-33.56,-15.17,-8.29,-15.95,0.54,-1.09,1.78,26.45,-5.76,-32.96,24.64,-14.93,-6.03,-5.58,26.15,17.67,5.43,21.86,41.65,44.69,37.7,48.52,52.99,31.39,37.21,37.61,29.7,32.66,23.79,48.28,52.35,51.0,63.81,38.27,53.23,66.76],"phase":["Neutral","Neutral","El Niño","El Niño","La Niña","Neutral","Neutral","El Niño","Neutral","El Niño","El Niño","La Niña","Neutral","El Niño","La Niña","La Niña","Neutral","Neutral","El Niño","Neutral","El Niño","Neutral","Neutral","La Niña","Neutral","Neutral","La Niña","Neutral","Neutral","Neutral","Neutral","El Niño","La Niña","La Niña","Neutral","Neutral","La Niña","La Niña","La Niña","El Niño","La Niña","La Niña","El Niño"]}}},"nat":"Agro-pastoral south","composites":[],"regressions":[],"tracker":[],"tracker_year":null,"elnino_stamp":null,"plans":[{"level":"national","name":"DCAN et Plan national de réponse (PNR) annuel","who":"Commissariat à la sécurité alimentaire (CSA) ; ministère des Affaires économiques","what":"Dispositif national de prévention et de réponse aux crises alimentaires et nutritionnelles (créé en 2021) : évaluation annuelle (enquêtes, pluviométrie, récoltes, prix), ciblage par le Cadre harmonisé, réponse en période de soudure, fonds spécial de l'État. Table ronde sur le financement du PNR 2026 en mai 2026, après une saison 2025 aux pluies mal réparties.","trigger":"Résultats du Cadre harmonisé (cycles de novembre et de mars)","elnino":"Pas spécifique à El Niño : la réponse 2026–27 sera fixée par le cycle de novembre 2026 du Cadre harmonisé.","url":"https://www.lecalame.info/?q=node%2F18542","src":"Le Calame, 22 May 2026"},{"level":"national","name":"Protection sociale adaptative : Registre social, Tekavoul et Elmaouna","who":"Taazour (délégation générale à la solidarité nationale), avec la Banque mondiale","what":"Tekavoul : transferts trimestriels aux ménages pauvres du Registre social (plus de 100 000 ménages en 2024 ; 3 600 MRU par trimestre). Elmaouna : réponse saisonnière en espèces aux sécheresses et inondations depuis 2017 (plus de 131 000 ménages, environ 814 000 personnes, 2017–2023), étendue aux réfugiés de M'bera.","trigger":"Choc de sécheresse ou d'inondation (lié au système d'alerte précoce)","elnino":"L'instrument principal pour monter en charge vite si la saison 2026 échoue ; la question est l'échelle face aux besoins.","url":"https://www.banquemondiale.org/fr/news/feature/2024/09/05/afw-transforming-lives-in-mauritania-through-adaptive-social-protection","src":"World Bank, 5 September 2024"},{"level":"national","name":"Assurance sécheresse indicielle (African Risk Capacity) et ADRiFi","who":"CSA, African Risk Capacity (Union africaine), Banque africaine de développement","what":"Assurance paramétrique : versement quand un indice pluviométrique signale des pertes. Premier versement de l'ARC en janvier 2015 : 25 millions USD partagés entre la Mauritanie, le Niger et le Sénégal. ADRiFi (BAD, don de 2,1 millions USD) a payé la moitié des primes 2020–2021 et préparé un plan de réponse à la sécheresse.","trigger":"Indice de sécheresse fondé sur la pluie (Africa RiskView)","elnino":"La couverture de la saison 2026 n'est pas confirmée par les sources consultées.","url":"https://www.mfw4a.org/news/drought-arc-pay-out-25-million-mauritania-niger-and-senegal","src":"MFW4A, 27 January 2015; AfDB (ReliefWeb)"},{"level":"national","name":"Prévision saisonnière de l'Office national de la météorologie (ONM)","who":"ONM","what":"Prévision d'avril 2026 : cumuls globalement normaux avec des tendances déficitaires ; juillet–septembre normal à déficitaire dans l'est agro-pastoral, déficitaire à normal à l'ouest.","trigger":"Températures océaniques (Pacifique, Atlantique, océan Indien, Méditerranée) et modèles climatiques","elnino":"Cohérent avec la note El Niño d'AGRHYMET : l'ouest du Sahel est le plus exposé.","url":"https://lecalame.info/?q=node%2F18346","src":"Le Calame, 5 April 2026"},{"level":"regional","name":"Cadre harmonisé, PREGEC et RPCA (CILSS)","who":"CILSS / AGRHYMET, cellules nationales du Cadre harmonisé","what":"Classification consensuelle de l'insécurité alimentaire en cinq phases, deux fois par an, qui fixe les plans nationaux de réponse. Mauritanie, cycle de novembre 2025 : 0,3 million de personnes en phase 3+ (octobre–décembre 2025, 6 %), 0,5 million projetées pour juin–août 2026 (9,4 %) ; déficits fourragers localisés.","trigger":"Phase 3 (crise) ou pire","elnino":"Le cycle de novembre 2026 sera le premier à refléter la saison El Niño 2026.","url":"https://agrhymet.cilss.int/wp-content/uploads/2026/08/RRSAN_DEFsigned.pdf","src":"AGRHYMET, Rapport régional 2026 sur la sécurité alimentaire et nutritionnelle"},{"level":"regional","name":"Note technique El Niño d'AGRHYMET et prévisions saisonnières (PRESASS)","who":"Centre climatique régional AGRHYMET","what":"Note de mai 2026 : un El Niño fort n'implique pas automatiquement une mauvaise saison au Sahel ; l'ouest du Sahel (Sénégal, Mauritanie, ouest du Mali) est le plus exposé aux déficits, longues pauses et sécheresse agricole. Recommande de suivre l'Atlantique, de mettre à jour les prévisions et de les utiliser en agriculture, élevage, eau et gestion des risques.","trigger":"Prévision saisonnière","elnino":"Orientations spécifiques à El Niño pour la région.","url":"https://agrhymet.cilss.int/wp-content/uploads/2026/06/Technical-Note_AGRHYMET_ElNino_2026_English.pdf","src":"AGRHYMET, 31 May 2026"},{"level":"regional","name":"Programme de protection sociale adaptative au Sahel (PPSAS)","who":"Fonds fiduciaire multi-donateurs de la Banque mondiale ; agences nationales (Taazour en Mauritanie)","what":"Appuie la protection sociale adaptative au Burkina Faso, Mali, Mauritanie, Niger, Sénégal et Tchad (plus de 277 millions USD depuis 2014) : filets sociaux, inclusion économique, aide temporaire après un choc, registres sociaux, paiements numériques. Troisième phase (2025–2030) lancée en mai 2026, centrée sur les femmes, les jeunes et l'emploi.","trigger":"Chocs identifiés par les systèmes nationaux","elnino":"Canal pour des transferts précoces avant la soudure 2027.","url":"https://www.worldbank.org/en/news/press-release/2026/05/12/sahel-adaptive-social-protection-program-launches-next-phase-accelerate-job-creation-and-boost-resilience-in-the-sahel","src":"World Bank, 12 May 2026"},{"level":"international","name":"Appel conjoint FAO–PAM d'action anticipatoire El Niño (juin 2026–mars 2027)","who":"FAO, PAM","what":"202 millions USD pour 8,8 millions de personnes dans 22 pays (espèces, semences tolérantes à la sécheresse, protection du bétail, stockage de l'eau, alerte précoce). La Mauritanie et le Sahel n'en font pas partie.","trigger":"Prévisions El Niño et seuils par pays","elnino":"Un manque pour la Mauritanie : pas d'enveloppe internationale d'anticipation identifiée.","url":"https://www.fao.org/newsroom/detail/bracing-for-el-ni%C3%B1o--fao-and-wfp-launch-joint-appeal-to-protect-8.8-million-people-from-extreme-weather-events/en","src":"FAO, 18 June 2026"},{"level":"international","name":"Action précoce de la Croix-Rouge et du Croissant-Rouge et CERF des Nations unies","who":"FICR, sociétés nationales, Centre climatique Croix-Rouge Croissant-Rouge ; OCHA (CERF)","what":"14 protocoles d'action précoce prêts en Afrique ; le CERF a pré-positionné jusqu'à 100 millions USD pour les pays à haut risque (septembre 2026). Recommandé pour le Sahel sec : stockage de l'eau, semences tolérantes, conservation des pâturages, déstockage précoce, santé animale, gestion des tensions sur les couloirs de transhumance.","trigger":"Seuils fondés sur les prévisions, propres à chaque protocole","elnino":"Aucun protocole propre à la Mauritanie identifié dans les sources consultées.","url":"https://www.climatecentre.org/17861/el-nino-2026-27-no-excuse-for-inaction/","src":"Red Cross Red Crescent Climate Centre, 28 September 2026"}],"as_of":"4 November 2026","sources":["NOAA CPC, Relative Oceanic Niño Index (RONI); ENSO diagnostic discussion, 8 October 2026.","AGRHYMET RCC-WAS (2026). Technical Note — El Niño 2026, 31 May 2026.","El Niño notebook (El_Nino_impacts_MRT.ipynb): FAO ASIS / CHIRPS rainfall, ERA5-Land temperature, FAO ASIS / MODIS NDVI.","DCAN et Plan national de réponse (PNR) annuel — Le Calame, 22 May 2026 : https://www.lecalame.info/?q=node%2F18542","Protection sociale adaptative : Registre social, Tekavoul et Elmaouna — World Bank, 5 September 2024 : https://www.banquemondiale.org/fr/news/feature/2024/09/05/afw-transforming-lives-in-mauritania-through-adaptive-social-protection","Assurance sécheresse indicielle (African Risk Capacity) et ADRiFi — MFW4A, 27 January 2015; AfDB (ReliefWeb) : https://www.mfw4a.org/news/drought-arc-pay-out-25-million-mauritania-niger-and-senegal","Prévision saisonnière de l'Office national de la météorologie (ONM) — Le Calame, 5 April 2026 : https://lecalame.info/?q=node%2F18346","Cadre harmonisé, PREGEC et RPCA (CILSS) — AGRHYMET, Rapport régional 2026 sur la sécurité alimentaire et nutritionnelle : https://agrhymet.cilss.int/wp-content/uploads/2026/08/RRSAN_DEFsigned.pdf","Note technique El Niño d'AGRHYMET et prévisions saisonnières (PRESASS) — AGRHYMET, 31 May 2026 : https://agrhymet.cilss.int/wp-content/uploads/2026/06/Technical-Note_AGRHYMET_ElNino_2026_English.pdf","Programme de protection sociale adaptative au Sahel (PPSAS) — World Bank, 12 May 2026 : https://www.worldbank.org/en/news/press-release/2026/05/12/sahel-adaptive-social-protection-program-launches-next-phase-accelerate-job-creation-and-boost-resilience-in-the-sahel","Appel conjoint FAO–PAM d'action anticipatoire El Niño (juin 2026–mars 2027) — FAO, 18 June 2026 : https://www.fao.org/newsroom/detail/bracing-for-el-ni%C3%B1o--fao-and-wfp-launch-joint-appeal-to-protect-8.8-million-people-from-extreme-weather-events/en","Action précoce de la Croix-Rouge et du Croissant-Rouge et CERF des Nations unies — Red Cross Red Crescent Climate Centre, 28 September 2026 : https://www.climatecentre.org/17861/el-nino-2026-27-no-excuse-for-inaction/"]}